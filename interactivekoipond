            const t = Date.now();
            ctx.fillStyle = '#0c2a42'; ctx.fillRect(0, 0, W, H);
            const wg = ctx.createRadialGradient(W/2, H*0.4, 0, W/2, H*0.5, Math.max(W, H)*0.8);
            wg.addColorStop(0, 'rgba(55,115,160,0.65)'); wg.addColorStop(0.4, 'rgba(40,85,125,0.45)');
            wg.addColorStop(0.7, 'rgba(25,60,95,0.25)'); wg.addColorStop(1, 'rgba(10,35,60,0)');
            ctx.fillStyle = wg; ctx.fillRect(0, 0, W, H);
            const vg = ctx.createRadialGradient(W/2, H/2, W*0.2, W/2, H/2, W*0.8);
            vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(0.7, 'rgba(0,10,20,0.1)'); vg.addColorStop(1, 'rgba(0,5,15,0.2)');
            ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);
            drawCaustics(t);
            const pt = t*0.008;
            for (let i = 0; i < 40; i++) { const s = i*47.3, x = (s*23 + pt*(0.5+(i%3)*0.3) + sin(t*0.001+s)*20)%W;
                const y = (s*19 + pt*(0.3+(i%4)*0.2) + cos(t*0.0008+s)*15)%H, sz = 1 + (i%3)*0.5, op = 0.02 + sin(t*0.002+s)*0.015;
                ctx.fillStyle = `rgba(200,220,240,${op})`; ctx.beginPath(); ctx.arc(x, y, sz, 0, PI2); ctx.fill(); }
            for (let i = foodParticles.length-1; i >= 0; i--) { const f = foodParticles[i]; f.update(); f.draw(); if (f.offScreen() || f.eaten) foodParticles.splice(i, 1); }
            for (let i = ripples.length-1; i >= 0; i--) { const r = ripples[i]; r.update(); r.draw(); if (r.done()) ripples.splice(i, 1); }
            smallFish.forEach(f => f.update(allFish, smallFish)); smallFish.forEach(f => f.draw());
            allFish.forEach(f => f.update(allFish)); allFish.forEach(f => f.draw());
            mapleLeaves.forEach(l => { l.update(allFish); l.draw(); });
            requestAnimationFrame(animate);
        }
        animate();
    </script>
</body>
